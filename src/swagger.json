{
    "openapi": "3.0.0",
    "info": {
        "title": "Documentação da API",
        "contact": {
            "email": "pablonobre.dev@gmail.com"
        }
    },
    "paths": {
        "/api/setor": {
            "post": {
                "summary": "Criar novo setor",
                "tags": [
                    "Setor"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "nomeSetor": {
                                        "type": "string",
                                        "example": "Cardiologia"
                                    },
                                    "isPrimeiroContato": {
                                        "type": "boolean",
                                        "example": true
                                    }
                                },
                                "required": [
                                    "nomeSetor",
                                    "isPrimeiroContato"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Setor criado com sucesso"
                    }
                }
            }
        },
        "/api/setor/{id}": {
            "put": {
                "summary": "Atualizar setor existente",
                "tags": [
                    "Setor"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "description": "UUID do setor"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "nomeSetor": {
                                        "type": "string",
                                        "example": "Ortopedia"
                                    },
                                    "isPrimeiroContato": {
                                        "type": "boolean",
                                        "example": false
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Setor atualizado com sucesso"
                    }
                }
            },
            "delete": {
                "summary": "Deletar setor existente",
                "tags": [
                    "Setor"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "description": "UUID do setor"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Setor deletado com sucesso"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT",
                "description": "Token JWT obtido na rota de login (/api/login)"
            }
        },
        "schemas": {
               
        }
    }
}